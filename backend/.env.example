# Database (Supabase)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT].supabase.co:6543/postgres?pgbouncer=true"
SUPABASE_URL="https://[PROJECT].supabase.co"
SUPABASE_ANON_KEY="sb_anon_[KEY]"
SUPABASE_SERVICE_KEY="[SERVICE_KEY]"

# JWT & Security
JWT_SECRET="[GENERATE_STRONG_SECRET]"          # >= 32 chars; diferente do refresh
JWT_REFRESH_SECRET="[GENERATE_STRONG_SECRET]"  # >= 32 chars; diferente do access
ENCRYPTION_KEY="[BASE64_ENCODED_32_BYTES]"
ENCRYPTION_MASTER_KEY="[64_HEX_CHARS]"         # envelope encryption: openssl rand -hex 32
ADMIN_API_KEY="[GENERATE_STRONG_KEY]"

# CORS — origens permitidas, separadas por vírgula
ALLOWED_ORIGINS="https://agentfy.tech,https://app.agentfy.tech"

# LLM APIs
ANTHROPIC_API_KEY="sk-ant-[KEY]"
OPENAI_API_KEY="sk-[KEY]"
GOOGLE_GEMINI_API_KEY="[KEY]"
GROQ_API_KEY="[KEY]"

# Stripe (Billing)
STRIPE_SECRET_KEY="sk_live_[KEY]"
STRIPE_PUBLISHABLE_KEY="pk_live_[KEY]"
STRIPE_WEBHOOK_SECRET="whsec_[KEY]"

# Redis (BullMQ)
REDIS_URL="redis://default:[PASSWORD]@[HOST]:[PORT]"

# Email Service
SENDGRID_API_KEY="SG.[KEY]"
SENDER_EMAIL="noreply@agentfy.tech"

# WhatsApp Evolution API
EVOLUTION_API_URL="https://evolution.agentfy.tech"
EVOLUTION_API_KEY="[KEY]"

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN="[TOKEN_DEFINIDO_NO_PAINEL_META]"
WHATSAPP_TOKEN="[SYSTEM_USER_ACCESS_TOKEN]"   # fallback global (opcional se cada agente tiver o seu)
META_APP_SECRET="[APP_SECRET_DO_META]"        # valida assinatura X-Hub-Signature-256
WHATSAPP_API_VERSION="v20.0"

# Admin Dashboard
ADMIN_EMAIL="admin@agentfy.tech"
ADMIN_PASSWORD="[CHANGE_ME]"

# App Config
NODE_ENV="production"
PORT="3001"
FRONTEND_URL="https://agentfy.tech"
API_URL="https://api.agentfy.tech"

# Feature Flags
ENABLE_WHITELABEL="true"
ENABLE_MARKETPLACE="false"
ENABLE_CUSTOM_DOMAINS="false"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_BILLING_MAX="10"

# Logs
LOG_LEVEL="info"
