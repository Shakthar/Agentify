// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // PgBouncer (porta 6543) — para queries
  directUrl = env("DIRECT_URL")     // Ligação direta (porta 5432) — para migrations
}

// ===== TENANTS (Revendedores) =====
model Tenant {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  passwordHash          String
  companyName           String?
  domain                String?    @unique // Para white-label
  plan                  String     @default("free") // free, starter, pro, business, enterprise
  creditsTotal          Int        @default(0)
  creditsUsed           Int        @default(0)
  creditsRefreshDate    DateTime   @default(now())
  waMsgsSent            Int        @default(0) // Total de mensagens WA/Instagram enviadas (billing)
  stripeCustomerId      String?    @unique
  stripeSubscriptionId  String?
  encryptionKey         String? // AES-256 key (armazenado em Vault, não aqui)
  
  // Billing
  monthlyRecurringRevenue Float @default(0)
  paymentStatus         String @default("inactive") // active, overdue, inactive

  // Subscription (platform billing)
  subscriptionMethod    String    @default("manual")  // stripe | ifthenpay_mbway | ifthenpay_multibanco | manual
  subscriptionStatus    String    @default("active")  // active | suspended | pending_payment | trial
  subscriptionExpiresAt DateTime?                     // end of current paid period
  
  // Two-Factor Authentication (TOTP)
  twoFactorSecret       String?
  twoFactorEnabled      Boolean  @default(false)
  // Anti-replay: último código TOTP usado (formato "window:code").
  // Persiste em DB para sobreviver a restarts do servidor e a deployments multi-instância.
  twoFactorLastCode     String?

  // Platform admin
  isAdmin           Boolean  @default(false)

  // Profile / Billing info
  phone             String?
  vatNumber         String?  // NIF / VAT para faturação
  addressLine1      String?
  addressCity       String?
  addressCountry    String?
  addressZip        String?

  // White-label branding
  brandColor        String?  // hex, ex: #3b57f0
  logoUrl           String?  // URL pública do logotipo

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  // Relations
  // Programa de indicação
  referralCode          String?    @unique
  referralCredits       Int        @default(0)
  referredBy            String?    // código do tenant que indicou

  // Agency model
  isAgency              Boolean    @default(false)
  agencyId              String?    // tenant pai (agência)
  agencyName            String?
  agencyBrandColor      String?
  agencyLogoUrl         String?

  agents                Agent[]
  crmContacts           CrmContact[]
  conversations         Conversation[]
  creditHistory         CreditLog[]
  refreshTokens         RefreshToken[]
  knowledgeBases        KnowledgeBase[]
  agentDocs             AgentDoc[]
  orders                Order[]
  platformInvoices      PlatformInvoice[]
}

// ===== PLATFORM EXPENSES (superadmin) =====
model PlatformExpense {
  id          String   @id @default(cuid())
  category    String   // hosting, api, support, marketing, misc
  description String
  amount      Float    // EUR
  recurring   Boolean  @default(false)
  period      String   @default("monthly") // monthly, yearly, one-time
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

// ===== AGENTS =====
model Agent {
  id                    String     @id @default(cuid())
  tenantId              String
  name                  String
  description           String?
  systemPrompt          String     @db.Text
  model                 String     @default("claude-haiku-4-5-20251001") // claude-haiku-4-5-20251001, claude-sonnet-4-5-20250929, gpt-4o-mini, etc
  temperature           Float      @default(0.7)
  maxTokens             Int        @default(2000)
  
  // Channels
  whatsappEnabled       Boolean    @default(false)
  whatsappNumber        String?    // phone_number_id do Meta
  whatsappToken         String?    // System User Access Token do cliente (encriptado)
  whatsappWebhookUrl    String?
  notifyPhone           String?    // Número WA do dono do negócio para notificações de pedidos (ex: 351912345678)
  webChatEnabled        Boolean    @default(true)
  whitelabelEnabled     Boolean    @default(false) // Página /w/[agentId] pública sem branding Agentfy (addon pago)
  emailEnabled          Boolean    @default(false)
  
  // Skills
  skillHandoff          Boolean    @default(true)
  skillDataCollection   Boolean    @default(true)
  skillScheduling       Boolean    @default(true)
  skillFileUpload       Boolean    @default(true)
  skillHumorDetection   Boolean    @default(false) // Pro+
  skillVendas           Boolean    @default(false) // Addon — inclui Pedidos/KDS
  skillCRM              String?    // HubSpot, Salesforce, etc
  skillTicketing        String?
  
  // Settings
  offHoursMessage       String?
  offHourStart          String?
  offHourEnd            String?
  
  // Analytics
  totalConversations    Int        @default(0)
  totalMessages         Int        @default(0)
  averageResolution     Float      @default(0)
  waMsgsSent            Int        @default(0) // Total de mensagens WA/Instagram enviadas por este agente
  
  // Multi-língua
  languageMode          String     @default("auto") // auto | pt | en | es | fr

  // Avaliação pós-conversa
  ratingEnabled         Boolean    @default(true)

  // Notificações proativas
  proactiveEnabled      Boolean    @default(false)
  proactiveMaxPerDay    Int        @default(50)
  proactiveMonthBudget  Int        @default(100)
  proactiveSentToday    Int        @default(0)
  proactiveSentMonth    Int        @default(0)
  proactiveResetDay     DateTime?
  proactiveResetMonth   DateTime?

  // Follow-up automático
  followUpEnabled       Boolean    @default(false)
  followUpHours         Int        @default(24)
  followUpMessage       String?    @db.Text

  // Alertas
  alertEmail                String?
  alertHandoffThreshold     Int?
  alertResolutionThreshold  Int?
  alertWeeklyReport         Boolean    @default(false)

  // CRM
  crmEnabled            Boolean    @default(false)

  // Instagram DM
  instagramEnabled      Boolean    @default(false)
  instagramAccountId    String?
  instagramToken        String?

  // Google Calendar
  calendarEnabled       Boolean    @default(false)
  calendarId            String?
  calendarToken         String?

  testMode              Boolean    @default(true) // Modo sandbox — desativar para produção
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  creditAllocations     CreditAllocation[]
  knowledgeBase         KnowledgeBase?
  agentDocs             AgentDoc[]
  orders                Order[]

  @@index([tenantId])
}


// ===== CRM CONTACTS =====
model CrmContact {
  id                  String     @id @default(cuid())
  tenantId            String
  agentId             String?
  phone               String?
  name                String?
  email               String?
  status              String     @default("lead") // lead | cliente | inativo | vip
  tags                String[]   @default([])
  notes               String?    @db.Text
  firstSeenAt         DateTime   @default(now())
  lastSeenAt          DateTime   @default(now())
  totalConversations  Int        @default(0)
  totalMessages       Int        @default(0)
  avgSentiment        Float?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  tenant              Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([phone])
}

// ===== CONVERSATIONS =====
model Conversation {
  id                    String     @id @default(cuid())
  tenantId              String
  agentId               String
  channelType           String     // whatsapp, web, email
  externalId            String?    // WhatsApp message ID, etc
  visitorId             String?    // Visitor/customer identifier
  visitorName           String?    // Nome do cliente (aprendido durante a conversa)

  // Avaliação pós-conversa
  rating                Int?       // 1-5 estrelas
  ratingText            String?    @db.Text

  // Follow-up automático
  followUpSent          Boolean    @default(false)
  followUpScheduledAt   DateTime?

  // Content (encrypted)
  messages              Message[]
  summary               String?    @db.Text
  
  // Sentiment & Quality
  sentiment             Float?     // -1.0 to +1.0
  urgency               String?    // low, medium, high, critical
  resolved              Boolean    @default(false)
  handedOffToHuman      Boolean    @default(false)
  humanAgent            String?
  
  // Metadata
  modelUsed             String?
  tokensUsed            Int        @default(0)
  creditsUsed           Int        @default(0)
  waMsgsSent            Int        @default(0) // Mensagens WA/Instagram enviadas nesta conversa
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  closedAt              DateTime?

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent                 Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@index([visitorId])
}

// ===== MESSAGES =====
model Message {
  id                    String     @id @default(cuid())
  conversationId        String
  role                  String     // user, assistant
  content               String     @db.Text // Encrypted
  contentIV             String?    // Initialization vector for encryption
  
  // Metadata
  tokens                Int        @default(0)
  model                 String?
  timestamp             DateTime   @default(now())

  // Relations
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ===== CREDITS =====
model CreditLog {
  id                    String     @id @default(cuid())
  tenantId              String
  amount                Int        // positive = added, negative = consumed
  reason                String     // chat, signup-bonus, purchase, refund, monthly-reset
  details               Json?                  // { agentId, model, messageCount, etc }
  
  createdAt             DateTime   @default(now())

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

// ===== CREDIT ALLOCATIONS (por agente) =====
model CreditAllocation {
  id                    String     @id @default(cuid())
  agentId               String
  allocatedCredits      Int
  usedCredits           Int        @default(0)
  lastResetDate         DateTime   @default(now())

  // Relations
  agent                 Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId])
}

// ===== REFRESH TOKENS =====
model RefreshToken {
  id                    String     @id @default(cuid())
  tenantId              String
  tokenHash             String     @unique
  expiresAt             DateTime
  revokedAt             DateTime?
  createdAt             DateTime   @default(now())

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ===== KNOWLEDGE BASE =====
model KnowledgeBase {
  id                    String     @id @default(cuid())
  agentId               String     @unique
  tenantId              String
  
  // Sources
  documents             Document[]
  embeddingModel        String     @default("text-embedding-3-small")
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  agent                 Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
}

// ===== DOCUMENTS =====
model Document {
  id                    String     @id @default(cuid())
  knowledgeBaseId       String
  
  type                  String     // pdf, docx, csv, youtube, website, text
  sourceUrl             String?
  fileName              String?
  content               String     @db.Text // Raw content

  // Ingestion status
  status                String     @default("pending") // pending, processing, completed, failed
  error                 String?    @db.Text
  chunkCount            Int        @default(0)
  contentBytes          Int        @default(0) // tamanho do conteúdo em bytes (para limites por plano)
  
  // Embeddings
  embeddings            Embedding[]
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  knowledgeBase         KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

// ===== EMBEDDINGS (pgvector) =====
model Embedding {
  id                    String     @id @default(cuid())
  documentId            String
  
  chunk                 String     @db.Text // Text chunk
  embedding             String     // pgvector format (stored as text for JSON compatibility)
  chunkIndex            Int
  
  createdAt             DateTime   @default(now())

  // Relations
  document              Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ===== STRIPE EVENTS =====
model StripeEvent {
  id                    String     @id
  type                  String
  data                  Json
  processed             Boolean    @default(false)
  error                 String?
  createdAt             DateTime   @default(now())

  @@index([processed])
}

// ===== AUDIT LOG =====
model AuditLog {
  id                    String     @id @default(cuid())
  tenantId              String?
  action                String     // create_agent, delete_conversation, purchase_credits, etc
  resourceType          String?
  resourceId            String?
  details               Json?
  
  createdAt             DateTime   @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ===== AGENT DOCS (documentos que o agente pode enviar aos clientes) =====
model AgentDoc {
  id          String   @id @default(cuid())
  agentId     String
  tenantId    String
  name        String           // Nome de exibição
  description String?          // Descrição opcional
  fileUrl     String           // URL pública no Supabase Storage
  fileName    String           // Nome original do ficheiro
  mimeType    String
  fileSize    Int      @default(0)
  storageKey  String           // Caminho no bucket (para delete)
  createdAt   DateTime @default(now())

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([tenantId])
}

// ===== ORDERS (pedidos c/ pagamento MB Way) =====
model Order {
  id            String    @id @default(cuid())
  tenantId      String
  agentId       String
  conversationId String
  externalId    String?   // ID do pagamento no Easypay
  buyerPhone    String    // telm do cliente (para MB Way + WA)
  amount        Float     // valor em euros
  description   String    // resumo do pedido
  status        String    @default("pending") // pending | paid | failed | expired
  notifyPhone   String?   // WA do dono a notificar após pagamento
  paidAt        DateTime?
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@index([externalId])
  @@index([status])
}

// ===== PLATFORM INVOICES (subscrições da plataforma) =====
model PlatformInvoice {
  id          String    @id @default(cuid())
  tenantId    String
  plan        String                           // plano subscrito
  amount      Float                            // valor em euros
  method      String                           // stripe | ifthenpay_mbway | ifthenpay_multibanco | manual
  status      String    @default("pending")    // pending | paid | failed | expired | cancelled
  reference   String?                          // MB Way: telefone; Multibanco: referência; Stripe: sessionId
  entity      String?                          // Multibanco: entidade (ex: 11249)
  externalId  String?                          // ID externo no gateway
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
}

// ===== PLATFORM CONFIG (pricing & feature flags — editable by superadmin) =====
model PlatformConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
