// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // PgBouncer (porta 6543) — para queries
  directUrl = env("DIRECT_URL")     // Ligação direta (porta 5432) — para migrations
}

// ===== TENANTS (Revendedores) =====
model Tenant {
  id                    String     @id @default(cuid())
  name                  String
  email                 String     @unique
  passwordHash          String
  companyName           String?
  domain                String?    @unique // Para white-label
  plan                  String     @default("free") // free, starter, pro, business, enterprise
  creditsTotal          Int        @default(0)
  creditsUsed           Int        @default(0)
  creditsRefreshDate    DateTime   @default(now())
  stripeCustomerId      String?    @unique
  stripeSubscriptionId  String?
  encryptionKey         String? // AES-256 key (armazenado em Vault, não aqui)
  
  // Billing
  monthlyRecurringRevenue Float @default(0)
  paymentStatus         String @default("inactive") // active, overdue, inactive
  
  // Two-Factor Authentication (TOTP)
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)

  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  // Relations
  agents                Agent[]
  conversations         Conversation[]
  creditHistory         CreditLog[]
  refreshTokens         RefreshToken[]
  knowledgeBases        KnowledgeBase[]
}

// ===== AGENTS =====
model Agent {
  id                    String     @id @default(cuid())
  tenantId              String
  name                  String
  description           String?
  systemPrompt          String     @db.Text
  model                 String     @default("claude-haiku-4-5-20251001") // claude-haiku-4-5-20251001, claude-sonnet-4-5-20250929, gpt-4o-mini, etc
  temperature           Float      @default(0.7)
  maxTokens             Int        @default(2000)
  
  // Channels
  whatsappEnabled       Boolean    @default(false)
  whatsappNumber        String?    // phone_number_id do Meta
  whatsappToken         String?    // System User Access Token do cliente (encriptado)
  whatsappWebhookUrl    String?
  webChatEnabled        Boolean    @default(true)
  emailEnabled          Boolean    @default(false)
  
  // Skills
  skillHandoff          Boolean    @default(true)
  skillDataCollection   Boolean    @default(true)
  skillScheduling       Boolean    @default(true)
  skillFileUpload       Boolean    @default(true)
  skillHumorDetection   Boolean    @default(false) // Pro+
  skillCRM              String?    // HubSpot, Salesforce, etc
  skillTicketing        String?
  
  // Settings
  offHoursMessage       String?
  offHourStart          String?
  offHourEnd            String?
  
  // Analytics
  totalConversations    Int        @default(0)
  totalMessages         Int        @default(0)
  averageResolution     Float      @default(0)
  
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations         Conversation[]
  creditAllocations     CreditAllocation[]
  knowledgeBase         KnowledgeBase?

  @@index([tenantId])
}

// ===== CONVERSATIONS =====
model Conversation {
  id                    String     @id @default(cuid())
  tenantId              String
  agentId               String
  channelType           String     // whatsapp, web, email
  externalId            String?    // WhatsApp message ID, etc
  visitorId             String?    // Visitor/customer identifier
  
  // Content (encrypted)
  messages              Message[]
  summary               String?    @db.Text
  
  // Sentiment & Quality
  sentiment             Float?     // -1.0 to +1.0
  urgency               String?    // low, medium, high, critical
  resolved              Boolean    @default(false)
  handedOffToHuman      Boolean    @default(false)
  humanAgent            String?
  
  // Metadata
  modelUsed             String?
  tokensUsed            Int        @default(0)
  creditsUsed           Int        @default(0)
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  closedAt              DateTime?

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent                 Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
  @@index([visitorId])
}

// ===== MESSAGES =====
model Message {
  id                    String     @id @default(cuid())
  conversationId        String
  role                  String     // user, assistant
  content               String     @db.Text // Encrypted
  contentIV             String?    // Initialization vector for encryption
  
  // Metadata
  tokens                Int        @default(0)
  model                 String?
  timestamp             DateTime   @default(now())

  // Relations
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ===== CREDITS =====
model CreditLog {
  id                    String     @id @default(cuid())
  tenantId              String
  amount                Int        // positive = added, negative = consumed
  reason                String     // chat, signup-bonus, purchase, refund, monthly-reset
  details               Json?                  // { agentId, model, messageCount, etc }
  
  createdAt             DateTime   @default(now())

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([createdAt])
}

// ===== CREDIT ALLOCATIONS (por agente) =====
model CreditAllocation {
  id                    String     @id @default(cuid())
  agentId               String
  allocatedCredits      Int
  usedCredits           Int        @default(0)
  lastResetDate         DateTime   @default(now())

  // Relations
  agent                 Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId])
}

// ===== REFRESH TOKENS =====
model RefreshToken {
  id                    String     @id @default(cuid())
  tenantId              String
  tokenHash             String     @unique
  expiresAt             DateTime
  revokedAt             DateTime?
  createdAt             DateTime   @default(now())

  // Relations
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ===== KNOWLEDGE BASE =====
model KnowledgeBase {
  id                    String     @id @default(cuid())
  agentId               String     @unique
  tenantId              String
  
  // Sources
  documents             Document[]
  embeddingModel        String     @default("text-embedding-3-small")
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  agent                 Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant                Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([agentId])
}

// ===== DOCUMENTS =====
model Document {
  id                    String     @id @default(cuid())
  knowledgeBaseId       String
  
  type                  String     // pdf, docx, csv, youtube, website, text
  sourceUrl             String?
  fileName              String?
  content               String     @db.Text // Raw content

  // Ingestion status
  status                String     @default("pending") // pending, processing, completed, failed
  error                 String?    @db.Text
  chunkCount            Int        @default(0)
  contentBytes          Int        @default(0) // tamanho do conteúdo em bytes (para limites por plano)
  
  // Embeddings
  embeddings            Embedding[]
  
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // Relations
  knowledgeBase         KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)

  @@index([knowledgeBaseId])
}

// ===== EMBEDDINGS (pgvector) =====
model Embedding {
  id                    String     @id @default(cuid())
  documentId            String
  
  chunk                 String     @db.Text // Text chunk
  embedding             String     // pgvector format (stored as text for JSON compatibility)
  chunkIndex            Int
  
  createdAt             DateTime   @default(now())

  // Relations
  document              Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

// ===== STRIPE EVENTS =====
model StripeEvent {
  id                    String     @id
  type                  String
  data                  Json
  processed             Boolean    @default(false)
  error                 String?
  createdAt             DateTime   @default(now())

  @@index([processed])
}

// ===== AUDIT LOG =====
model AuditLog {
  id                    String     @id @default(cuid())
  tenantId              String?
  action                String     // create_agent, delete_conversation, purchase_credits, etc
  resourceType          String?
  resourceId            String?
  details               Json?
  
  createdAt             DateTime   @default(now())

  @@index([tenantId])
  @@index([createdAt])
}
