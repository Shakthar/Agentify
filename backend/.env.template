# ========================
# SERVIDOR
# ========================
PORT=3001
NODE_ENV=development

# Origens permitidas pelo CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# ========================
# BASE DE DADOS
# ========================
# ATENÇÃO: Copiar DIRETAMENTE do Supabase Dashboard → Settings → Database → Connection string
# Nunca escrever manualmente — caracteres especiais na password devem ser % encoded
# DATABASE_URL  = Connection pooling URI (porta 6543) com ?pgbouncer=true
# DIRECT_URL    = Direct connection URI  (porta 5432) SEM ?pgbouncer
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.PROJETO.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.PROJETO.supabase.co:5432/postgres

# ========================
# JWT
# ========================
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# LLMs
# ========================
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ========================
# STRIPE (Fase 2)
# ========================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ========================
# REDIS / BullMQ (Fase 3)
# ========================
REDIS_URL=redis://localhost:6379
